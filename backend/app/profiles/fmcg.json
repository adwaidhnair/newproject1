{
  "industry_type": "FMCG",
  "terminology": {
    "item": "SKU",
    "location": "Distribution hub",
    "vendor": "Supplier",
    "order": "Purchase order"
  },
  "default_rules": [
    {
      "rule_code": "PO_LATE_DELIVERY",
      "rule_name": "Late supplier delivery",
      "module": "PROCUREMENT",
      "metric": "delivery_delay_days",
      "operator": ">",
      "threshold_value": 0,
      "severity": "HIGH"
    },
    {
      "rule_code": "INV_BELOW_REORDER",
      "rule_name": "Stock below reorder level",
      "module": "INVENTORY",
      "metric": "stock_on_hand_vs_reorder_level",
      "operator": "<",
      "threshold_value": 1,
      "severity": "CRITICAL"
    },
    {
      "rule_code": "INV_AGEING",
      "rule_name": "Ageing inventory",
      "module": "INVENTORY",
      "metric": "days_since_last_movement",
      "operator": ">",
      "threshold_value": 90,
      "severity": "MEDIUM"
    },
    {
      "rule_code": "AP_OVERBILLING",
      "rule_name": "Invoice exceeds PO value",
      "module": "FINANCE",
      "metric": "invoice_vs_po_amount",
      "operator": ">",
      "threshold_value": 0,
      "severity": "CRITICAL"
    }
  ]
}
